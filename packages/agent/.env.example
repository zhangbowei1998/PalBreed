BREEDING_API_BASE_URL=http://localhost:8000
AGENT_MAX_DEPTH=10
AGENT_MAX_NODES=200
AGENT_ROUTE_TIMEOUT_MS=8000
AGENT_TOP_CANDIDATES=3
AGENT_DUPLICATE_EXPAND_LIMIT=3

# LLM（DeepSeek / OpenAI-compatible）
# 关闭时：走规则识别 + 现有交互流程
# 开启时：agent-service 会让 LLM 通过 function calling 调用 deterministic tools
LLM_ENABLED=false
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_S=15

# 记忆存储
# LONG_TERM_STORE=file    → JSON 文件（开发/测试）
# LONG_TERM_STORE=postgres → PostgreSQL 持久化（生产）
LONG_TERM_STORE=postgres
DATABASE_URL=postgresql://postgres@localhost:5432/pl_agent

# 短期记忆窗口（保留最近 N 轮 user+assistant，超出部分用 LLM 压缩成摘要）
SHORT_TERM_MAX_TURNS=12

# 用户体系
# USER_STORE=file    → JSON 文件（开发/测试）
# USER_STORE=postgres → PostgreSQL 持久化（生产）
USER_STORE=postgres
AUTH_SECRET=change-me-in-production
AUTH_TOKEN_TTL_S=604800
