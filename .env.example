# ============================================================
# Docker Compose 部署配置模板（提交到仓库，供参考）
# 部署时复制为 .env 并填写真实值
# ============================================================

# DeepSeek LLM（必填）
LLM_API_KEY=your-deepseek-api-key
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 用户体系 token 签名密钥（生产务必改为随机值）
AUTH_SECRET=change-me-to-a-long-random-string

# 邀请码体系
# ADMIN_USERNAME: 指定线上首个管理员用户名（仅该用户可生成邀请码）。
#                 建议部署后填入你自己的用户名；留空则首个注册用户自动成为管理员。
ADMIN_USERNAME=
# 邀请码有效期（秒），默认 7 天
INVITE_TTL_S=604800
